.vscode
*.pyc
__pycache__/
.pytest_cache/
*.swp
id_rsa
venv
*.log
crop.log.bak.txt
.idea
cropsbak
# Coverage data. The .coverage.* forms are the per-process files `parallel = True` produces - one per test
# subprocess - which are combined into .coverage and would otherwise pile up after an interrupted run.
.coverage
.coverage.*
coverage.xml
htmlcov/

# Logs the analyzer pulls off the pano store - a local cache, re-downloadable on every run.
log_analyzer/logs/

# raw cvMetadata dumps (~100 MB per city); regenerate with reports/scripts/pano_y_histogram.py
reports/scripts/.cache/

# Claude Code local agent state (worktrees, caches, per-machine settings). Never belongs in the repo.
# A shared .claude/settings.json is deliberately still trackable; only the .local. override is ignored.
.claude/worktrees/
.claude/settings.local.json
